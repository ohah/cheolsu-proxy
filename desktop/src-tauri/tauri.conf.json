{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cheolsu Proxy",
  "version": "0.1.0",
  "identifier": "com.cheolsu-proxy",
  "build": {
    "beforeDevCommand": "bash build-mcp.sh && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash build-mcp.sh release && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cheolsu Proxy",
        "width": 1440,
        "height": 1080
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ohah/cheolsu-proxy/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MkE2MDczNTg4Nzg5MDcKUldRSGlZZFljMkFxZDRDQno3TGppWjJlVjNaQkFOVlE0OEFTaFlHVnB4RmZSUnRpa2xla2cxeFkK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": ["icons/logo.png"],
    "externalBin": ["binaries/cheolsu-proxy-mcp", "binaries/cheolsu"],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [
        "frameworks/libssl.3.dylib",
        "frameworks/libcrypto.3.dylib"
      ],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "wix": {
        "language": "ko-KR"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true
      }
    }
  }
}
