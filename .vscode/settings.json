{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/.vscode/**": true
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc"
  },
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  }
}
