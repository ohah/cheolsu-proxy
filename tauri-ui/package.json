{
  "name": "cheolsu-proxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:mock": "MOCK=true vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri-dev": "npm run log:backup && tauri dev",
    "tauri:local": "IS_PROXY=false tauri",
    "tauri": "tauri",
    "tauri:dev:log": "bun run log:backup && LOG=true tauri dev",
    "log:backup": "cd src-tauri/logs && TODAY=$(date +%Y-%m-%d) && echo \"TODAY: $TODAY\" && echo \"Checking file: proxy.log.$TODAY\" && if [ -f proxy.log.$TODAY ]; then echo \"File exists, starting backup process\" && for i in {99..1}; do if [ -f proxy.log.$TODAY.old$i ]; then echo \"Moving proxy.log.$TODAY.old$i to proxy.log.$TODAY.old$((i+1))\" && mv proxy.log.$TODAY.old$i proxy.log.$TODAY.old$((i+1)); fi; done && echo \"Moving proxy.log.$TODAY to proxy.log.$TODAY.old1\" && mv proxy.log.$TODAY proxy.log.$TODAY.old1 && echo \"Backup completed\"; else echo \"File does not exist\"; fi",
    "log:generate": "npm run log:backup && cd /Users/yoon/Documents/workspace/proxelar && timeout 20s cargo run -p proxyapi_v2 --example log",
    "log:clean": "cd src-tauri/logs && TODAY=$(date +%Y-%m-%d) && rm -f proxy.log.$TODAY.old*",
    "test": "bun test --preload ./test/setup.ts test/stores test/entities",
    "test:e2e": "bun test --timeout 60000 test/e2e",
    "test:all": "bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "2.4.5",
    "@tauri-apps/plugin-http": "2.5.7",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-store": "2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.7.1",
    "react-router-dom": "^7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@happy-dom/global-registrator": "^20.8.3",
    "@hypothesi/tauri-mcp-server": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
