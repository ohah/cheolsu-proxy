{
  "name": "cheolsu-proxy-root",
  "version": "0.1.1",
  "private": true,
  "description": "A simple Man In The Middle proxy built with Rust and Tauri",
  "keywords": [
    "documentation",
    "mitm",
    "proxy",
    "rust",
    "tauri"
  ],
  "license": "MIT",
  "author": "Cheolsu Proxy Team",
  "workspaces": [
    "desktop",
    "document"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter cheolsu-proxy-document dev",
    "build": "bun run --filter cheolsu-proxy-document build",
    "preview": "bun run --filter cheolsu-proxy-document preview",
    "tauri": "bun run --filter cheolsu-proxy tauri dev",
    "tauri:dev": "bun run --filter cheolsu-proxy tauri dev",
    "tauri:build": "bun run --filter cheolsu-proxy tauri build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev:mock": "MOCK=true bun run --filter cheolsu-proxy dev -- --port 12308 --host 0.0.0.0",
    "cargo:test": "DYLD_LIBRARY_PATH=$(pwd)/desktop/src-tauri/openssl-bundle/lib cargo test",
    "cargo:check": "cargo check",
    "cargo:fmt": "cargo fmt --all",
    "cargo:clean": "cargo clean",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "shadcn": "^3.8.5"
  },
  "packageManager": "bun@latest"
}
